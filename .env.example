# Required: inclusive Holiday Afternoon Tea date range.
DATE_START=2026-11-18
DATE_END=2027-01-12

# Optional comma-separated dates to skip.
EXCLUDE_DATES=2026-11-25,2026-11-26

# OpenTable lists this experience for parties of 1 through 6.
PARTY_SIZE=4

# Inclusive booking window in America/New_York, using 24-hour time.
TIME_START=11:00
TIME_END=16:00

# Local Chrome is often less likely to be blocked than a data-center browser.
BROWSER_CHANNEL=chrome

# OpenTable currently permits a normal local Chrome session more reliably than
# a headless one. A short-lived Chrome window will appear during each check.
HEADLESS=false

# Optional Slack-compatible or Discord-compatible JSON webhook.
# ALERT_WEBHOOK_URL=https://...
# ALERT_WEBHOOK_BEARER=
